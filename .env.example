# Ojo: una clave vacía (CLAVE=) NO toma el valor por defecto de config/, vale "".
# Si no se va a usar una variable, comentarla o borrarla en vez de dejarla vacía.

# El nombre define la cookie de sesión (ocobo_session), que el proxy del front espera.
APP_NAME=Ocobo
# Producción: APP_ENV=production y APP_DEBUG=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://ocobo-back.test

# Producción: LOG_CHANNEL=daily (rota el archivo y conserva 14 días) y LOG_LEVEL=warning
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ocobo_back
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=reverb
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# sync: los jobs se ejecutan dentro de la petición (no hay tabla jobs ni worker)
QUEUE_CONNECTION=sync

SESSION_DRIVER=file
SESSION_LIFETIME=480
# Producción: dominio compartido por front y back, p. ej. .midominio.com
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
# Sin definir: cookie segura solo con APP_ENV=production (en producción el sitio debe ir por https)
# SESSION_SECURE_COOKIE=

# Dominios (host[:puerto], sin esquema) del front que usan la sesión de Sanctum
SANCTUM_STATEFUL_DOMAINS=localhost:3000,ocobo.test:3000
# Orígenes (con esquema) del front, separados por comas
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://ocobo.test:3000

# Laravel Reverb - WebSockets (php artisan reverb:start)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=localhost
REVERB_PORT=8080
# Producción: https
REVERB_SCHEME=http

# Local: log (los correos van a storage/logs). Producción: smtp
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@ocobo.test
MAIL_FROM_NAME="${APP_NAME}"

# Tesseract OCR
TESSERACT_ENABLED=true
TESSERACT_PATH=tesseract
TESSERACT_LANG=spa+eng

# ImageMagick (ruta al ejecutable magick)
# IMAGEMAGICK_PATH=

# OCR Service (Microservicio Python PaddleOCR)
OCR_ENABLED=false
OCR_SERVICE_URL=http://localhost:5000
OCR_TIMEOUT=60
# Secreto compartido con el microservicio OCR; sin él el servicio rechaza las extracciones
OCR_SERVICE_TOKEN=
OCR_SERVICE_HOST=127.0.0.1

# TSA - Timestamp Authority (RFC 3161)
TSA_URL=https://timestamp.digicert.com
